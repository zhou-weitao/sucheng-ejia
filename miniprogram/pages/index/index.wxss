.container {
  padding: 0;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 🔍 搜索栏 */
.search-bar {
  background: var(--color-gradient);
  padding: var(--space-lg);
  padding-top: var(--space-md);
  box-shadow: var(--shadow-primary);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--color-white);
  border-radius: var(--radius-full);
  padding: var(--space-md) var(--space-lg);
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.search-input-wrap:active {
  transform: scale(0.98);
}

.search-icon {
  font-size: 28rpx;
  margin-right: var(--space-sm);
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-gray-900);
}

/* 🔘 筛选栏 */
.filter-bar {
  display: flex;
  background: var(--color-white);
  border-bottom: 1rpx solid var(--color-gray-300);
  padding: 0 var(--space-xs);
  box-shadow: var(--shadow-sm);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) 0;
  font-size: 26rpx;
  color: var(--color-gray-700);
  transition: all 0.2s ease;
  position: relative;
}

.filter-item:active {
  background: var(--color-gray-100);
}

.filter-item .arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  color: var(--color-gray-500);
  transition: transform 0.2s ease;
}

.filter-item:active .arrow {
  transform: rotate(180deg);
}

/* 📋 列表区域 */
.list-wrap {
  padding: var(--space-md);
}

.list-item {
  display: flex;
  background: var(--color-white);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.list-item:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

.item-left {
  margin-right: var(--space-md);
  position: relative;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  background: var(--color-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-white);
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow-md);
}

.match-badge {
  background: linear-gradient(135deg, var(--color-success), #34d399);
  color: var(--color-white);
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  text-align: center;
  display: block;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.item-middle {
  flex: 1;
  min-width: 0;
}

.item-top-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  flex-wrap: wrap;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-gray-900);
  margin-right: var(--space-sm);
}

.item-tag {
  background: var(--color-success-bg);
  color: var(--color-success);
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
}

.match-score {
  font-size: 22rpx;
  color: var(--color-success);
  margin-left: auto;
  font-weight: 600;
  background: var(--color-success-bg);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.item-info-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: var(--space-sm);
  gap: 12rpx;
}

.info-tag {
  background: var(--color-gray-100);
  color: var(--color-gray-700);
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-md);
}

.item-desc {
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-bottom: var(--space-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.5;
}

.item-bottom-row {
  display: flex;
  align-items: center;
}

.distance {
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-right: var(--space-md);
}

.tutor-rating {
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.rating-stars {
  display: flex;
  align-items: center;
  color: var(--color-gold);
  margin-right: 8rpx;
}

.rating-stars .star {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.rating-count {
  color: var(--color-gray-500);
  font-size: 20rpx;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  margin-left: var(--space-md);
  flex-shrink: 0;
}

.price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-error);
  letter-spacing: -1rpx;
}

.price-unit {
  font-size: 20rpx;
  color: var(--color-gray-500);
}

/* 📭 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: var(--space-md);
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-gray-500);
}

/* 🔽 筛选弹窗 */
.filter-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  backdrop-filter: blur(4rpx);
}

.popup-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-white);
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.1);
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--color-gray-300);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-gray-900);
}

.close-btn {
  font-size: 36rpx;
  color: var(--color-gray-500);
  padding: 10rpx;
  transition: all 0.2s ease;
}

.close-btn:active {
  color: var(--color-error);
  transform: scale(1.1);
}

.popup-list {
  padding: var(--space-sm) 0;
  max-height: 60vh;
  overflow-y: auto;
}

.popup-item {
  padding: var(--space-md) var(--space-lg);
  font-size: 28rpx;
  color: var(--color-gray-700);
  border-bottom: 1rpx solid var(--color-gray-100);
  transition: all 0.2s ease;
}

.popup-item:last-child {
  border-bottom: none;
}

.popup-item:active {
  background: var(--color-gray-100);
}

.popup-item.active {
  color: var(--color-primary);
  font-weight: 700;
  background: rgba(102, 126, 234, 0.08);
}

.popup-item.active::before {
  content: '✓';
  margin-right: 12rpx;
  color: var(--color-primary);
}
