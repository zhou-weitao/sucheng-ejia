/* 登录页 - 现代简约设计 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 800;
  color: #667eea;
  margin-bottom: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(102, 126, 234, 0.3);
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 2rpx;
}

.btn-box {
  width: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  background: #fff;
  color: #667eea;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 30rpx 0;
  margin-bottom: 48rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.init-btn text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}
