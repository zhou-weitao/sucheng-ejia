<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">我的订单</text>
    <text class="subtitle">共 {{list.length}} 条记录</text>
  </view>

  <!-- 列表 -->
  <view class="list-wrap" wx:if="{{!loading && !empty}}">
    <view class="list-item" wx:for="{{list}}" wx:key="_id">
      <view class="item-header">
        <view class="order-no">订单号：{{item.orderNo}}</view>
        <view class="item-status {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</view>
      </view>

      <view class="item-content">
        <view class="item-row">
          <text class="label">{{userRole === 'parent' ? '老师：' : '学生：'}}</text>
          <text class="value">{{userRole === 'parent' ? item.tutorName : item.studentName}}</text>
        </view>
        <view class="item-row">
          <text class="label">科目：</text>
          <text class="value">{{item.subject}}</text>
        </view>
        <view class="item-row">
          <text class="label">时间：</text>
          <text class="value">{{item.date}} {{item.time}}</text>
        </view>
        <view class="item-row">
          <text class="label">地点：</text>
          <text class="value">{{item.address}}</text>
        </view>
      </view>

      <view class="item-footer">
        <view class="price-info">
          <text class="price-label">订单金额：</text>
          <text class="price">¥{{item.totalAmount}}</text>
          <text class="price-desc">（{{item.price}}元/小时 × {{item.hours}}小时）</text>
        </view>
        <view class="item-actions" wx:if="{{item.status === 'pending'}}">
          <button class="action-btn contact-btn" bindtap="onContact" data-item="{{item}}">联系对方</button>
          <button class="action-btn cancel-btn" bindtap="onCancel" data-item="{{item}}">取消订单</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && empty}}">
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无订单记录</text>
    <button class="action-btn" bindtap="goIndex">去首页看看</button>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
