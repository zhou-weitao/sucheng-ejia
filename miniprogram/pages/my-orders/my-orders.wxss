.container {
  padding: 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 40rpx 30rpx 60rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.list-wrap {
  margin-top: -30rpx;
  padding: 0 20rpx 40rpx;
}

.list-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.item-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-processing {
  background: #e6f7ff;
  color: #1890ff;
}

.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

.status-cancelled {
  background: #fff1f0;
  color: #ff4d4f;
}

.item-content {
  margin-bottom: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #999;
  width: 100rpx;
  flex-shrink: 0;
}

.value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.item-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.price-info {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5576c;
  margin: 0 8rpx;
}

.price-desc {
  font-size: 22rpx;
  color: #999;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  font-weight: 500;
  line-height: 1;
}

.contact-btn {
  background: #f0f2ff;
  color: #667eea;
}

.cancel-btn {
  background: #fff1f0;
  color: #f5576c;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  font-size: 28rpx;
  color: #999;
}
