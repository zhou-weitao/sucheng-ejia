.container {
  padding: 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.user-header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  margin-right: 28rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.role-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.role-badge.parent {
  background: rgba(255, 180, 0, 0.3);
}

.member-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffd700;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.vip {
  font-size: 20rpx;
  font-weight: 800;
  color: #fff;
}

.vip-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
}

.stats-card {
  background: #fff;
  margin: -40rpx 20rpx 20rpx;
  border-radius: 20rpx;
  padding: 40rpx 0;
  display: flex;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
  align-self: center;
}

.menu-card {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
}

.menu-icon.blue {
  background: rgba(102, 126, 234, 0.1);
}

.menu-icon.green {
  background: rgba(103, 194, 58, 0.1);
}

.menu-icon.purple {
  background: rgba(118, 75, 162, 0.1);
}

.menu-icon.orange {
  background: rgba(255, 152, 0, 0.1);
}

.menu-icon.cyan {
  background: rgba(23, 162, 184, 0.1);
}

.menu-content {
  flex: 1;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-badge {
  background: #f5576c;
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  font-weight: 500;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

.logout-wrap {
  padding: 40rpx;
}

.logout-btn {
  width: 100%;
  background: #fff;
  color: #f5576c;
  border: 2rpx solid rgba(245, 87, 108, 0.2);
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}
