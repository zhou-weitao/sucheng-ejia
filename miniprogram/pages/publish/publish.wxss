/* 发布需求页 */
.container {
  padding: 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 40rpx 30rpx 60rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.form-card {
  background: #fff;
  margin: -30rpx 20rpx 0;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.required {
  color: #f5576c;
}

.picker {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
  min-height: 88rpx;
  box-sizing: border-box;
}

.picker.selected {
  border-color: #667eea;
  color: #333;
}

.arrow {
  font-size: 20rpx;
  color: #ccc;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 16rpx 28rpx;
  background: #f5f7fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tag.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(118, 75, 162, 0.15));
  border-color: #667eea;
  color: #667eea;
  font-weight: 600;
}

.input {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 88rpx;
}

.textarea {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.btn-wrap {
  padding: 40rpx 30rpx 60rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.5;
}
