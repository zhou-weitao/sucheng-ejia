.container {
  padding: 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 20rpx 30rpx 40rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.placeholder {
  width: 60rpx;
}

.rating-summary {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
}

.rating-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 40rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.2);
}

.rating-number {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-bottom: 8rpx;
}

.rating-stars {
  display: flex;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.rating-stars .star {
  font-size: 24rpx;
}

.rating-stars .star.full {
  color: #ffd700;
}

.rating-stars .star.half {
  color: #ffd700;
  position: relative;
}

.rating-stars .star.empty {
  color: rgba(255, 255, 255, 0.3);
}

.rating-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.rating-right {
  flex: 1;
  padding-left: 40rpx;
}

.rating-bar {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.rating-bar:last-child {
  margin-bottom: 0;
}

.bar-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  width: 60rpx;
  flex-shrink: 0;
}

.bar-wrap {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #ffd700;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.list-wrap {
  margin-top: -20rpx;
  padding: 0 20rpx 40rpx;
}

.list-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.reviewer-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.reviewer-detail {
  display: flex;
  flex-direction: column;
}

.reviewer-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.rating-stars-small {
  display: flex;
  gap: 2rpx;
}

.rating-stars-small .star-small {
  font-size: 20rpx;
}

.rating-stars-small .star-small.full {
  color: #ffd700;
}

.rating-stars-small .star-small.half {
  color: #ffd700;
}

.rating-stars-small .star-small.empty {
  color: #ddd;
}

.review-date {
  font-size: 22rpx;
  color: #999;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 22rpx;
  color: #667eea;
  background: #f0f2ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.item-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.item-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #ccc;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 24rpx;
  color: #ccc;
}

.loading {
  text-align: center;
  padding: 100rpx;
  font-size: 28rpx;
  color: #999;
}
